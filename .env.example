# ============================================================
# Incident Memory Agent — Environment Variables Template
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real values below
# 3. NEVER commit .env to GitHub — it's in .gitignore
# ============================================================

# --- Gemini API ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase ---
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# --- Supabase Direct DB Connection (for pgvector SQL) ---
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
